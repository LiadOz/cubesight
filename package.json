{
  "name": "cubesight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:wasm": "cargo build --manifest-path wasm-core/Cargo.toml --target wasm32-unknown-unknown --release && wasm-bindgen wasm-core/target/wasm32-unknown-unknown/release/corner_recognition_core.wasm --out-dir src/wasm --target web --out-name cubesight_core",
    "generate:pwa-assets": "pwa-assets-generator",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:pwa": "playwright test --config=playwright.pwa.config.js",
    "test:unit": "node --test tests/*-unit.test.mjs",
    "test:rust": "cargo test --manifest-path wasm-core/Cargo.toml"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "playwright": "^1.63.0",
    "three": "^0.180.0",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
