{
  "name": "cubesight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:wasm": "cargo build --manifest-path wasm-core/Cargo.toml --target wasm32-unknown-unknown --release && wasm-bindgen wasm-core/target/wasm32-unknown-unknown/release/corner_recognition_core.wasm --out-dir src/wasm --target web --out-name cubesight_core",
    "generate:pwa-assets": "pwa-assets-generator",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:pwa": "playwright test --config=playwright.pwa.config.js",
    "test:unit": "node --test tests/*-unit.test.mjs",
    "queue": "node scripts/merge-queue.mjs",
    "perf": "node scripts/perf.mjs",
    "perf:check": "node scripts/perf-check.mjs",
    "test:rust": "cargo test --manifest-path wasm-core/Cargo.toml",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "gallery:coverage": "node scripts/gallery-coverage.mjs",
    "check": "npm run lint && npm run test:unit && npm run build && node scripts/check-no-dev-gallery.mjs && npm run gallery:coverage",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:layout": "playwright test --config=playwright.layout.config.js",
    "test:snapshots": "playwright test --config=playwright.snapshots.config.js",
    "snapshots:update": "playwright test --config=playwright.snapshots.config.js --update-snapshots=missing",
    "snapshots:compare": "node scripts/snapshots-compare.mjs",
    "test:affected": "node scripts/test-affected.mjs",
    "test:shard": "node scripts/test-shard.mjs",
    "test:impact-map": "node scripts/test-impact-map.mjs",
    "test:health": "node scripts/test-health.mjs",
    "test:flaky": "node scripts/test-flaky.mjs",
    "test:merge": "node scripts/test-tiers.mjs merge",
    "test:regression": "node scripts/test-tiers.mjs regression"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "three": "^0.180.0",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "es-module-lexer": "^1.7.0"
  },
  "dependencies": {
    "cubing": "^0.63.7",
    "smartcube-web-bluetooth": "git+https://github.com/poliva/smartcube-web-bluetooth.git#44f1f091c6e980d9cc31e6d2863c4437eca3ab3c"
  }
}
